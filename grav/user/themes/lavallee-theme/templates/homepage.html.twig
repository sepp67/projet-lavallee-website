{% extends 'partials/base.html.twig' %}

{% block body_class %}accent-amber{% endblock %}
{% block statusbar %}{% endblock %}

{% block footer_suffix %}{{ 'THEME.FOOTER_SUFFIX.HOME'|t }}{% endblock %}

{% block content %}
  {% set articles_page = page.find('/articles') %}
  {% set latest_articles = articles_page.children.published
    |sort((a, b) => (b.header.date ? b.header.date|date('U') : 0) <=> (a.header.date ? a.header.date|date('U') : 0))
    |slice(0, 3) %}
  {% set notes_techniques %}
    <div class="notes-grid">
      {% for article in latest_articles %}
        {% include 'partials/article-card.html.twig' with { article: article } %}
      {% endfor %}
    </div>
    <div class="notes-see-all">
      <a href="{{ articles_page.url }}" class="flag-link">{{ 'THEME.NOTES.SEE_ALL'|t }}</a>
    </div>
  {% endset %}
  {{ page.content|replace({'<!-- notes-techniques:latest-articles -->': notes_techniques})|raw }}

  <section class="final-cta" id="contact">
    <div class="wrap">
      <h2>{{ 'THEME.HOME_CTA.TITLE'|t }}</h2>
      <p>{{ 'THEME.HOME_CTA.TEXT'|t }}</p>
      <div class="contact-form-wrap">
        {% include 'forms/form.html.twig' with { form: forms('contact-form') } %}
      </div>
    </div>
  </section>
{% endblock %}
